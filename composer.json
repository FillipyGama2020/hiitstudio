{
    "name": "fillipygama/hiitstudio",
    "description": "Plataforma de agendamento de aulas e assinaturas para estudio de treino funcional, com checkout via Pagar.me e Mercado Pago",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-pdo": "*",
        "ext-curl": "*",
        "vlucas/phpdotenv": "^5.6",
        "phpmailer/phpmailer": "^6.9",
        "mercadopago/dx-php": "^3.0",
        "guzzlehttp/guzzle": "^7.9"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
